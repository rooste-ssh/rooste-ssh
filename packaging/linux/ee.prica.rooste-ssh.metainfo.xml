<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>ee.prica.rooste-ssh</id>
  <name>Rooste SSH</name>
  <summary>SSH, telnet and serial terminal with tabs, SFTP and port forwarding</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <developer id="ee.prica">
    <name>Martin Vooremäe</name>
  </developer>
  <description>
    <p>
      Rooste SSH is a memory-safe SSH client written in Rust. It keeps saved sessions in a
      searchable manager, opens them in tabs and split panes, and includes an SFTP file panel,
      port forwarding, jump hosts, a key generator and a built-in SSH agent. Telnet, raw TCP
      and serial connections are supported too.
    </p>
  </description>
  <launchable type="desktop-id">ee.prica.rooste-ssh.desktop</launchable>
  <url type="homepage">https://github.com/rooste-ssh/rooste-ssh</url>
  <url type="bugtracker">https://github.com/rooste-ssh/rooste-ssh/issues</url>
  <content_rating type="oars-1.1"/>
  <provides>
    <binary>rooste</binary>
    <binary>rooste-cli</binary>
  </provides>
  <releases>
    <release version="0.5.0" date="2026-11-05"/>
    <release version="0.4.0" date="2026-10-17"/>
    <release version="0.3.0" date="2026-10-16"/>
    <release version="0.2.1" date="2026-10-15"/>
    <release version="0.2.0" date="2026-10-14"/>
    <release version="0.1.1" date="2026-10-14"/>
    <release version="0.1.0" date="2026-10-14"/>
  </releases>
</component>
